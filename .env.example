# VepayDO backend - environment template.
# Copy to .env (never committed) and fill in real values.
# Every variable is validated at boot; an invalid environment fails fast.

# --- Runtime ---
ASPNETCORE_ENVIRONMENT=Development
PORT=3000

# --- Database (PostgreSQL 16) ---
# Runtime role: least privilege, NOSUPERUSER NOBYPASSRLS.
DATABASE_URL=postgresql://vepaydo_app:change-me@localhost:5432/vepaydo
# Owner role: used only to apply migrations. Never given to runtime services.
DIRECT_URL=postgresql://vepaydo_owner:change-me@localhost:5432/vepaydo
# Maintenance role: retention/purge only (BYPASSRLS).
MAINTENANCE_DATABASE_URL=postgresql://vepaydo_maintenance:change-me@localhost:5432/vepaydo

# --- Redis (queue, sessions revocation, lockout) ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
JWT_ACCESS_SECRET=change-me-min-32-chars-000000000000000000
REFRESH_TOKEN_PEPPER=change-me-min-32-chars-111111111111111111

# --- Object storage (S3-compatible: R2/B2 prod, MinIO dev) ---
# The client never talks to the storage directly: it asks the API for a signed URL.
# STORAGE_PROVIDER=inmemory keeps the bytes inside the API process (local run and tests).
STORAGE_PROVIDER=inmemory
# Public base URL of the API, used to build the signed URLs of the inmemory family.
STORAGE_PUBLIC_BASE_URL=http://localhost:3000
# Secret that signs those URLs (at least 32 characters).
STORAGE_SIGNING_SECRET=change-me-min-32-chars-222222222222222222
# Maximum size of an uploaded receipt, in bytes.
STORAGE_MAX_UPLOAD_BYTES=10000000
# Lifetime of a signed URL, in seconds.
STORAGE_SIGNED_URL_TTL_SECONDS=300

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=vepaydo
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# --- OCR service ---
OCR_SERVICE_URL=http://localhost:8000

# --- Push (FCM) ---
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# --- Observability ---
SENTRY_DSN=

# --- App ---
APP_ORIGIN=http://localhost:5173
BRAND_NAME=VepayDO

# --- Mail (Mailpit in dev) ---
MAIL_TRANSPORT=smtp
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=VepayDO <no-reply@vepaydo.local>

# --- Legal document versions ---
LEGAL_TERMS_VERSION=2026-01
LEGAL_PRIVACY_VERSION=2026-01
