<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <!-- JWT creation/validation for the access token; version matches the JwtBearer 10.0.13 dependency. -->
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.19.2" />
    <!-- argon2id for password hashing (AGENTS.md section 13). Pure managed, MIT, last release well over 14 days old. -->
    <PackageVersion Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="FluentValidation" Version="12.2.0" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
    <PackageVersion Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.0.0" />
    <!-- Core Serilog, referenced by the Infrastructure layer so the redaction
         policy can live next to the code that must never log sensitive data. -->
    <PackageVersion Include="Serilog" Version="4.2.0" />
    <!-- Serilog configuration files, shared by the API and the worker. -->
    <PackageVersion Include="Serilog.Settings.Configuration" Version="9.0.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <!-- FluentAssertions 7.2.0 is the last Apache-2.0 release (8.x is commercially licensed). -->
    <PackageVersion Include="FluentAssertions" Version="7.2.0" />
    <!-- Image decoding/re-encoding and EXIF stripping for receipt uploads. SkiaSharp is MIT;
         ImageSharp 3.x/4.x is under the Six Labors Split License and would require a paid
         commercial license. See ADR 0009. -->
    <PackageVersion Include="SkiaSharp" Version="3.119.4" />
    <!-- Native Skia binaries for the Linux container (no libfontconfig dependency). -->
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.4" />
    <!-- S3-compatible object storage (Apache-2.0). -->
    <PackageVersion Include="AWSSDK.S3" Version="4.0.104.6" />
    <!-- Background worker host (the receipt processing queue, M5.4). -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageVersion Include="Serilog.Extensions.Hosting" Version="9.0.0" />
  </ItemGroup>
</Project>
